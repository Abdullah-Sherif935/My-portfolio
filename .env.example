# Public Frontend Configuration (Safe to expose to browser)
# Never put private secrets or Supabase service_role keys in VITE_* variables.

VITE_APP_NAME="Abdullah Sherif Portfolio"
VITE_APP_ENV="development"
VITE_PUBLIC_SITE_URL="http://localhost:5173"

# Supabase Public Project Configuration (Phase 04)
# Copy this file to .env.local and fill in values from:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
